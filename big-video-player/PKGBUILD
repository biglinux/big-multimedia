# Maintainer: Bruno Goncalves <bigbruno@gmail.com>
# shellcheck shell=bash disable=SC2034,SC2154

# One package per directory, like big-kernel: gitrepo lists each directory
# and builds the ones chosen. Do not reference the pkgname or url variables
# in this file: a testing build in the CI expands them textually.

pkgname=big-video-player
_repo=big-multimedia
# Read once: makepkg sources this file again in its fakeroot pass, and both
# passes must agree on the version.
export BIG_PKGSTAMP="${BIG_PKGSTAMP:-$(date +%y.%m.%d-%H%M)}"
pkgver=${BIG_PKGSTAMP%-*}
pkgrel=${BIG_PKGSTAMP#*-}
pkgdesc='Hardware-accelerated video player for BigLinux'
arch=('x86_64')
url="https://github.com/biglinux/big-multimedia"
# The shipped GPU shaders: FSR/CAS and Anime4K are MIT, RAVU is LGPL-3.0.
license=('GPL-3.0-or-later' 'MIT' 'LGPL-3.0-or-later')
# ffmpeg renders the seek-bar preview thumbnails.
depends=('gtk4>=4.22' 'libadwaita>=1.9' 'mpv' 'ffmpeg' 'libpulse')
makedepends=('git' 'cargo' 'pkgconf' 'gettext')
optdepends=('deepfilternet3-native: light voice noise reduction (DeepFilterNet3)'
            'dpdfnet-native: higher-quality voice noise reduction (DPDFNet-2 48 kHz)'
            'big-video-converter: cut and convert videos'
            'big-audio-converter: extract audio from videos'
            'bignetscreen: play on a TV or Chromecast')
# Successor of the monorepo bigvideo package; big-video-module depends on
# bigvideo.
replaces=('big-player-video' 'bigvideo')
conflicts=('big-player-video' 'bigvideo')
provides=('bigvideo=0.1.0-7')
# makepkg's lto adds -flto to CFLAGS, so the C in ring and jemalloc builds as
# GCC bytecode that lld cannot link. The release profile already does fat LTO.
options=('!lto')

# Inside a checkout this recipe builds its working tree, uncommitted changes
# included. The CI receives only this directory and fetches from GitHub
# instead; keep that line literal, the builder appends #branch= to it.
_recipe_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)
_checkout=${_recipe_dir%/*}
if [ -e "${_checkout}/.git" ] && [ -f "${_checkout}/Cargo.toml" ]; then
    source=()
    sha256sums=()
else
    _checkout=
    source=("git+https://github.com/biglinux/big-multimedia.git")
    sha256sums=('SKIP')
fi

prepare() {
    if [ -n "${_checkout}" ]; then
        # The files git sees: tracked and new ones, without ignored output or
        # this recipe's own src/ and pkg/.
        rm -rf "${srcdir:?}/${_repo}"
        mkdir "${srcdir}/${_repo}"
        git -C "${_checkout}" ls-files -z --cached --others --exclude-standard \
            -- ":!:${_recipe_dir#"${_checkout}"/}" |
            tar -C "${_checkout}" --null --files-from=- --ignore-failed-read -cf - |
            tar -C "${srcdir}/${_repo}" -xf -
    fi
    cd "${srcdir}/${_repo}" || return
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "${srcdir}/${_repo}" || return
    export RUSTFLAGS="${RUSTFLAGS} --remap-path-prefix=${srcdir}/${_repo}=/build"
    cargo build --frozen --release -p big-video-player
}

package() {
    local tree="${srcdir}/${_repo}"
    local resources="${tree}/crates/big-video-player/resources"
    local id=br.com.biglinux.VideoPlayer

    install -Dm755 "${tree}/target/release/big-video-player" "${pkgdir}/usr/bin/big-video-player"
    install -Dm644 "${resources}/applications/${id}.desktop" \
        "${pkgdir}/usr/share/applications/${id}.desktop"
    install -Dm644 "${resources}/metainfo/${id}.metainfo.xml" \
        "${pkgdir}/usr/share/metainfo/${id}.metainfo.xml"
    install -Dm644 "${resources}/icons/hicolor/scalable/apps/big-video-player.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/big-video-player.svg"

    # The shared gettext catalog goes under the package's private locale dir,
    # which resolve_locale_dir() prefers, so the two co-installable players
    # never own the same file in /usr/share/locale.
    local po="${tree}/crates/media-runtime/po" lang
    while read -r lang; do
        [[ -z "${lang}" || "${lang}" == \#* ]] && continue
        install -d "${pkgdir}/usr/share/big-video-player/locale/${lang}/LC_MESSAGES"
        msgfmt "${po}/${lang}.po" \
            -o "${pkgdir}/usr/share/big-video-player/locale/${lang}/LC_MESSAGES/big-media-runtime.mo"
    done <"${po}/LINGUAS"

    # GPU shaders the filters dialog offers: without them its rows stay
    # "not installed" and saved choices do nothing.
    local shaders="${tree}/crates/media-runtime/data/shaders"
    local dest="${pkgdir}/usr/share/big-media-runtime/shaders" notice
    install -Dm644 -t "${dest}" "${shaders}/FSR.glsl" "${shaders}/CAS-scaled.glsl"
    install -Dm644 -t "${dest}/anime4k" "${shaders}"/anime4k/*.glsl
    install -Dm644 -t "${dest}/ravu" "${shaders}"/ravu/*.hook
    # MIT asks for its notice alongside: each shader's header block.
    install -d "${pkgdir}/usr/share/licenses/big-video-player"
    for notice in FSR.glsl CAS-scaled.glsl anime4k/Anime4K_Clamp_Highlights.glsl; do
        printf '%s:\n' "${notice}"
        awk '{sub(/\r$/, "")} {print} /SOFTWARE\.$/ {exit}' "${shaders}/${notice}"
        printf '\n'
    done >"${pkgdir}/usr/share/licenses/big-video-player/MIT-shaders"
}
