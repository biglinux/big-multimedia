# Load the AppArmor profile now when AppArmor runs; on later boots
# apparmor.service loads every profile in /etc/apparmor.d.

post_install() {
    [[ -d /sys/kernel/security/apparmor ]] || return 0
    command -v apparmor_parser >/dev/null || return 0
    apparmor_parser -r /etc/apparmor.d/big-video-player ||
        printf '%s\n' 'big-video-player: the AppArmor profile did not load; it applies once apparmor.service loads it.'
}

post_upgrade() {
    post_install
}

pre_remove() {
    [[ -d /sys/kernel/security/apparmor ]] || return 0
    command -v apparmor_parser >/dev/null || return 0
    # Fails only when the profile was never loaded, which leaves nothing to remove.
    apparmor_parser -R /etc/apparmor.d/big-video-player 2>/dev/null || :
}
