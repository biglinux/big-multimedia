# BigLinux shared ignore policy.

# VCS and editor state
.git/
.hg/
.svn/
.vscode/
.idea/
.serena/
.claude/
.codex/
*.swp
*.swo
*~

# Logs, dumps, local env
*.log
*.trace
*.profraw
*.profdata
*.pid
*.tmp
*.bak
*.orig
.env
.env.*
!.env.example

# Rust
/target/
**/target/
Cargo.lock.bak
*.rs.bk
fuzz/artifacts/
fuzz/corpus/*/crash-*
fuzz/corpus/*/timeout-*

# C/C++/Meson/Ninja
/build/
/builddir/
/builddir*/
compile_commands.json
.cache/
.ccls-cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.venv/
venv/
htmlcov/
.coverage
.coverage.*

# Node/web
node_modules/
dist/
coverage/
playwright-report/
test-results/
.astro/
.next/
.nuxt/
.svelte-kit/

# Android/Kotlin/Java
.gradle/
.kotlin/
*.class
*.jar
*.war
*.apk
*.aab
local.properties

# Packaging/build outputs
/pkg/
/packaging/pacman/pkg/
/packaging/pacman/src/
/pkgbuild/pkg/
/pkgbuild/src/
*.pkg.tar*
*.deb
*.rpm
result
result-*
.flatpak-builder/
repo/
build-dir/

# Generated docs/artifacts
target/doc/
.agent/tmp/

# Pipeline agent artifacts
tmp/
