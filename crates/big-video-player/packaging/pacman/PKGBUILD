# Maintainer: Bruno Goncalves <bigbruno@gmail.com>
# shellcheck shell=bash disable=SC2034,SC2154
#
# Self-contained build. big-video-player is a member of the big-multimedia
# Cargo workspace, which vendors the engine (big-media-runtime) and every
# shared component crate. No sibling repos, no tarball fetch: build the member
# in place against the workspace root (four levels up from this file).

pkgname=big-video-player
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
pkgdesc='Hardware-accelerated video player for BigLinux'
arch=('x86_64')
url='https://github.com/biglinux/big-multimedia'
license=('GPL-3.0-or-later')

# libpulse provides `pactl`, used to drive our PipeWire/PulseAudio stream volume
# so the in-app volume matches the system mixer (same %, with >100% boost).
# avahi provides `avahi-browse`, used to discover Chromecast devices on the LAN
# (the `chromecast` feature); ffmpeg is also its transcode backend; bubblewrap
# sandboxes every cast ffmpeg/ffprobe (they parse untrusted media).
depends=('gtk4' 'libadwaita' 'mpv' 'ffmpeg' 'libpulse' 'avahi' 'bubblewrap')
# Successor of the monorepo `bigvideo` package: replace it and satisfy the
# `bigvideo=…` dependency that `big-video-module` carries.
replaces=('big-player-video' 'bigvideo')
conflicts=('big-player-video' 'bigvideo')
provides=('bigvideo=0.1.0-7')
# Cutting, converting and extracting audio hand the file to the BigLinux
# converter GUIs; without them those menu entries are greyed out.
optdepends=('big-video-converter: cut and convert videos'
            'big-audio-converter: extract audio from videos')
# cmake builds aws-lc-sys (rustls backend pulled in by rust_cast for Chromecast).
makedepends=('cargo' 'pkgconf' 'gettext' 'cmake')

# Absolute path to the big-multimedia workspace root that owns this PKGBUILD.
_wsroot() {
  cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd -P
}

build() {
  local root; root="$(_wsroot)"
  export RUSTFLAGS="${RUSTFLAGS} --remap-path-prefix=${root}=/build --remap-path-prefix=${HOME}/.cargo=/cargo"
  cd "${root}" || return 1
  # `chromecast`: LAN device discovery (avahi) + CASTV2 streaming/transcode.
  cargo build --release --locked -p "${pkgname}" --features chromecast
}

package() {
  local root; root="$(_wsroot)"
  install -Dm755 "${root}/target/release/big-video-player" \
    "$pkgdir/usr/bin/big-video-player"

  cd "${root}/crates/big-video-player" || return 1
  install -Dm644 "resources/applications/br.com.biglinux.VideoPlayer.desktop" \
    "$pkgdir/usr/share/applications/br.com.biglinux.VideoPlayer.desktop"
  install -Dm644 "resources/metainfo/br.com.biglinux.VideoPlayer.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/br.com.biglinux.VideoPlayer.metainfo.xml"
  install -Dm644 "resources/icons/hicolor/scalable/apps/big-video-player.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/big-video-player.svg"

  # Shared gettext catalog (single `big-media-runtime` textdomain, bound by
  # shared::app_base::init_gettext). Installed under this package's PRIVATE
  # locale dir — resolve_locale_dir() prefers it — so a video-only install is
  # translated and the two co-installable players never collide on one file in
  # /usr/share/locale. Vendored at crates/media-runtime/po.
  local po="${root}/crates/media-runtime/po"
  if [[ -d "${po}" ]]; then
    while read -r _lang; do
      [[ -z "${_lang}" || "${_lang}" == \#* ]] && continue
      install -d "$pkgdir/usr/share/${pkgname}/locale/${_lang}/LC_MESSAGES"
      msgfmt "${po}/${_lang}.po" \
        -o "$pkgdir/usr/share/${pkgname}/locale/${_lang}/LC_MESSAGES/big-media-runtime.mo"
    done < "${po}/LINGUAS"
  fi
}
