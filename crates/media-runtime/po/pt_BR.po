msgstr "Próxima faixa"

#: crates/ui/media/big-media-components/src/audio/editor_panel.rs:116
msgid "Play only selected area"
msgstr "Reproduzir apenas a área selecionada"

#: crates/ui/media/big-media-components/src/audio/editor_panel.rs:117
msgid "Auto-advance to next track"
msgstr "Avançar automaticamente para a próxima faixa"

#: crates/ui/media/big-media-components/src/audio/editor_panel.rs:119
#: crates/ui/media/big-media-components/src/video/editor_sidebar.rs:72
msgid "Clear all segments"
