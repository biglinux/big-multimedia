msgid "Saved account security"
msgstr "Zabezpečení uložených účtů"

#: crates/big-audio-player/src/audio/account_security.rs:28
msgid "Checking saved credentials…"
msgstr "Kontrola uložených přihlašovacích údajů…"

#: crates/big-audio-player/src/audio/account_security.rs:31
msgid "Protect credentials"
msgstr "Chránit přihlašovací údaje"

