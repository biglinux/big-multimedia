msgid "Connecting…"
msgstr "Se conectează…"

#: crates/ui/media/big-player-ui/src/smartphone/dialog.rs:223
msgid "Connected to your computer"
msgstr "Conectat la calculatorul dvs."

#: crates/ui/media/big-player-ui/src/smartphone/dialog.rs:224
msgid "Disconnected. Check the network and keep the player open."
msgstr "Deconectat. Verificați rețeaua și lăsați playerul deschis."

#: crates/ui/media/big-player-ui/src/smartphone/dialog.rs:226
msgid ""
"Use only on a trusted local network. This HTTP connection is not encrypted."
msgstr ""
"Folosiți numai într-o rețea locală de încredere. Această conexiune HTTP nu "
"este criptată."

