# Maintainer: Bruno Goncalves <bigbruno@gmail.com>
# shellcheck shell=bash disable=SC2034,SC2154
#
# Self-contained build. big-audio-player is a member of the big-multimedia
# Cargo workspace, which vendors the engine (big-media-runtime) and every
# shared component crate. No sibling repos, no tarball fetch: build the member
# in place against the workspace root (four levels up from this file).

pkgname=big-audio-player
pkgver=0.1.0
pkgrel=9
pkgdesc='Music and audio player for BigLinux'
arch=('x86_64')
url='https://github.com/biglinux/big-multimedia'
license=('GPL-3.0-or-later')
# libpulse provides `pactl`, used to drive the PipeWire/PulseAudio stream volume
# (same backend as the video player).
depends=('gtk4' 'libadwaita' 'mpv' 'ffmpeg' 'libpulse')
makedepends=('cargo' 'pkgconf' 'gettext')
# The desktop entry launches through `big-jemalloc-run`, which preloads the
# patched jemalloc (the C23 free_sized NULL fix GTK4/GLib needs) and keeps it
# out of child processes. Optional: the runner is a no-op when either piece is
# missing, and the binary then falls back to glibc malloc.
optdepends=('big-jemalloc-scope: lower resident memory under GTK4 (measured -26% on the audio player)')

# Absolute path to the big-multimedia workspace root that owns this PKGBUILD.
_wsroot() {
  cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd -P
}

build() {
  local root; root="$(_wsroot)"
  export RUSTFLAGS="${RUSTFLAGS} --remap-path-prefix=${root}=/build --remap-path-prefix=${HOME}/.cargo=/cargo"
  cd "${root}" || return 1
  cargo build --release -p "${pkgname}"
}

package() {
  local root; root="$(_wsroot)"
  install -Dm755 "${root}/target/release/big-audio-player" \
    "$pkgdir/usr/bin/big-audio-player"

  cd "${root}/crates/big-audio-player" || return 1
  install -Dm644 "resources/applications/br.com.biglinux.AudioPlayer.desktop" \
    "$pkgdir/usr/share/applications/br.com.biglinux.AudioPlayer.desktop"
  install -Dm644 "resources/metainfo/br.com.biglinux.AudioPlayer.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/br.com.biglinux.AudioPlayer.metainfo.xml"
  install -Dm644 "resources/icons/hicolor/scalable/apps/big-audio-player.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/big-audio-player.svg"

  # Shared gettext catalog (single `big-media-runtime` textdomain, bound by
  # shared::app_base::init_gettext). Installed under this package's PRIVATE
  # locale dir — resolve_locale_dir() prefers it — so both co-installable
  # players can ship the catalog without colliding on one file in
  # /usr/share/locale. Vendored at crates/media-runtime/po.
  local po="${root}/crates/media-runtime/po"
  if [[ -d "${po}" ]]; then
    while read -r _lang; do
      [[ -z "${_lang}" || "${_lang}" == \#* ]] && continue
      install -d "$pkgdir/usr/share/${pkgname}/locale/${_lang}/LC_MESSAGES"
      msgfmt "${po}/${_lang}.po" \
        -o "$pkgdir/usr/share/${pkgname}/locale/${_lang}/LC_MESSAGES/big-media-runtime.mo"
    done < "${po}/LINGUAS"
  fi
}
