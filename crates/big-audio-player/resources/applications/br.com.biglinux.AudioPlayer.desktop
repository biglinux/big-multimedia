[Desktop Entry]
Type=Application
Name=Big Audio Player
Name[pt_BR]=Big Audio Player
GenericName=Music Player
GenericName[pt_BR]=Reprodutor de música
Comment=Music and audio player for BigLinux
Comment[pt_BR]=Reprodutor de música e áudio para o BigLinux
Exec=big-audio-player %F
TryExec=big-audio-player
Icon=big-audio-player
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=audio;music;player;mpris;mp3;flac;ogg;
Keywords[pt_BR]=áudio;música;reprodutor;mpris;mp3;flac;ogg;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/x-flac+ogg;audio/x-opus+ogg;audio/opus;audio/x-speex+ogg;audio/aac;audio/x-aac;audio/mp4;audio/x-m4a;audio/x-m4b;audio/vnd.wave;audio/wav;audio/x-wav;audio/x-aiff;audio/x-aifc;audio/x-ape;audio/x-wavpack;audio/x-ms-wma;audio/webm;audio/matroska;audio/x-matroska;audio/ac3;audio/vnd.dts;audio/vnd.dts.hd;audio/x-musepack;audio/x-tta;audio/amr;audio/amr-wb;audio/basic;audio/x-dff;audio/x-dsf;audio/usac;audio/x-mod;audio/x-it;audio/x-s3m;audio/x-xm;
StartupNotify=true
StartupWMClass=br.com.biglinux.AudioPlayer
X-GNOME-UsesNotifications=true
