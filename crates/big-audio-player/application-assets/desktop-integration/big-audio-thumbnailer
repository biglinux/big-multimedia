#!/usr/bin/env bash
# big-audio-thumbnailer — Extract embedded cover art from audio files.
# Used by Nautilus/Dolphin/Thunar to generate thumbnails.
#
# Install:
#   install -Dm755 big-audio-thumbnailer /usr/bin/big-audio-thumbnailer
#   install -Dm644 big-audio-thumbnailer.thumbnailer /usr/share/thumbnailers/
set -euo pipefail

readonly INPUT="${1:-}"
readonly OUTPUT="${2:-}"
readonly SIZE="${3:-128}"

if [[ -z "$INPUT" || -z "$OUTPUT" ]]; then
    printf 'Usage: big-audio-thumbnailer <input-file> <output-png> [size]\n' >&2
    exit 1
fi

cleanup_on_failure() {
    # Remove zero-byte or partial output so the file manager doesn't cache garbage.
    if [[ -f "$OUTPUT" && ! -s "$OUTPUT" ]]; then
        rm -f -- "$OUTPUT"
    fi
}
trap cleanup_on_failure EXIT

# Try ffmpeg first (most reliable).
if command -v ffmpeg >/dev/null 2>&1; then
    if ffmpeg -i -- "$INPUT" -an -vcodec png \
            -vf "scale=${SIZE}:${SIZE}:force_original_aspect_ratio=decrease" \
            -y -- "$OUTPUT" 2>/dev/null \
        && [[ -s "$OUTPUT" ]]; then
        exit 0
    fi
fi

# Fallback: mediainfo + base64.
if command -v mediainfo >/dev/null 2>&1 && command -v base64 >/dev/null 2>&1; then
    cover_data="$(mediainfo --Inform="General;%Cover_Data%" -- "$INPUT" 2>/dev/null || true)"
    if [[ -n "$cover_data" ]] \
        && printf '%s' "$cover_data" | base64 -d > "$OUTPUT" 2>/dev/null \
        && [[ -s "$OUTPUT" ]]; then
        exit 0
    fi
fi

exit 1
