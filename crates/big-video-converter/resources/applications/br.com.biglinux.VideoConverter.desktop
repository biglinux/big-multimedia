[Desktop Entry]
Type=Application
Name=Big Video Converter
Name[pt_BR]=Big Video Converter
GenericName=Video Converter
GenericName[pt_BR]=Conversor de vídeo
Comment=GPU-aware video converter for BigLinux
Comment[pt_BR]=Conversor de vídeo com aceleração de GPU para o BigLinux
Exec=big-video-converter %F
Icon=big-video-converter
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=video;convert;converter;transcode;ffmpeg;vaapi;nvenc;h264;h265;
Keywords[pt_BR]=vídeo;converter;conversor;transcodificar;ffmpeg;vaapi;nvenc;h264;h265;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;
StartupNotify=true
StartupWMClass=br.com.biglinux.VideoConverter
X-GNOME-UsesNotifications=true
